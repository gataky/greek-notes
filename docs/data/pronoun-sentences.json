[
{"rule": "before", "en": "Do you know Maria? Yes, *I know her*.", "el": "Ξέρεις τη Μαρία; Ναι, την ξέρω.", "answer": "την ξέρω"},
{"rule": "before", "en": "Where's the book? *I'm reading it*.", "el": "Πού είναι το βιβλίο; Το διαβάζω.", "answer": "το διαβάζω"},
{"rule": "before", "en": "The keys? *I have them*.", "el": "Τα κλειδιά; Τα έχω εγώ.", "answer": "τα έχω"},
{"rule": "before", "en": "Nikos? *I see him* every day.", "el": "Τον Νίκο; Τον βλέπω κάθε μέρα.", "answer": "τον βλέπω"},
{"rule": "before", "en": "Your sister? *I'm phoning her* now.", "el": "Την αδελφή σου; Της τηλεφωνώ τώρα.", "answer": "της τηλεφωνώ", "also": ["της τηλεφωνάω"], "note": "τηλεφωνώ takes the genitive: you phone to someone."},
{"rule": "before", "en": "My parents? *I'm writing them* a letter.", "el": "Οι γονείς μου; Τους γράφω ένα γράμμα.", "answer": "τους γράφω"},
{"rule": "before", "en": "The windows? *I'm closing them*.", "el": "Τα παράθυρα; Τα κλείνω.", "answer": "τα κλείνω"},
{"rule": "before", "en": "The soup? *I'm making it* now.", "el": "Τη σούπα; Τη φτιάχνω τώρα.", "answer": "τη φτιάχνω"},
{"rule": "before", "en": "Grandma? *I help her* in the kitchen.", "el": "Τη γιαγιά; Τη βοηθάω στην κουζίνα.", "answer": "τη βοηθάω", "also": ["τη βοηθώ"]},
{"rule": "before", "en": "*He gave me* the keys.", "el": "Μου έδωσε τα κλειδιά.", "answer": "μου έδωσε", "note": "\"Gave me\" is \"gave to me\": the genitive μου."},
{"rule": "before", "en": "*She asked us* where we live.", "el": "Μας ρώτησε πού μένουμε.", "answer": "μας ρώτησε"},
{"rule": "before", "en": "The coffee? *I drink it* without sugar.", "el": "Τον καφέ; Τον πίνω χωρίς ζάχαρη.", "answer": "τον πίνω", "note": "ο καφές is masculine, so \"it\" is τον."},
{"rule": "before", "en": "The book? *He gave it to me*.", "el": "Το βιβλίο; Μου το έδωσε.", "answer": "μου το έδωσε", "note": "Two pronouns before the verb: the genitive (to me) comes first."},
{"rule": "before", "en": "The letters? *I sent them to her*.", "el": "Τα γράμματα; Της τα έστειλα.", "answer": "της τα έστειλα"},
{"rule": "before", "en": "*I'm waiting for you*.", "el": "Σε περιμένω.", "answer": "σε περιμένω", "note": "περιμένω takes its object directly: no word for \"for\"."},
{"rule": "before", "en": "Your friends? *I'm meeting them* tonight.", "el": "Τους φίλους σου; Τους συναντάω απόψε.", "answer": "τους συναντάω"},
{"rule": "before", "en": "The doors? *I close them* every evening.", "el": "Τις πόρτες; Τις κλείνω κάθε βράδυ.", "answer": "τις κλείνω", "note": "οι πόρτες are feminine, so \"them\" is τις."},
{"rule": "before", "en": "*Do you understand me*?", "el": "Με καταλαβαίνεις;", "answer": "με καταλαβαίνεις"},
{"rule": "before", "en": "The cake? *We ate it* yesterday.", "el": "Την τούρτα; Τη φάγαμε χθες.", "answer": "τη φάγαμε"},
{"rule": "before", "en": "My cousin? *She brought me* a present.", "el": "Η ξαδέλφη μου; Μου έφερε ένα δώρο.", "answer": "μου έφερε"},
{"rule": "negation", "en": "Maria? *I don't know her*.", "el": "Τη Μαρία; Δεν την ξέρω.", "answer": "δεν την ξέρω"},
{"rule": "negation", "en": "The video? *I didn't see it*.", "el": "Το βίντεο; Δεν το είδα.", "answer": "δεν το είδα"},
{"rule": "negation", "en": "*I don't understand you*.", "el": "Δεν σε καταλαβαίνω.", "answer": "δεν σε καταλαβαίνω"},
{"rule": "negation", "en": "The bill? *I didn't pay it*.", "el": "Τον λογαριασμό; Δεν τον πλήρωσα.", "answer": "δεν τον πλήρωσα"},
{"rule": "negation", "en": "*He didn't tell me* anything.", "el": "Δεν μου είπε τίποτα.", "answer": "δεν μου είπε"},
{"rule": "negation", "en": "The keys? *I don't have them*.", "el": "Τα κλειδιά; Δεν τα έχω.", "answer": "δεν τα έχω"},
{"rule": "negation", "en": "The money? *He didn't give it to us*.", "el": "Τα λεφτά; Δεν μας τα έδωσε.", "answer": "δεν μας τα έδωσε", "note": "τα λεφτά is plural, so \"it\" is τα."},
{"rule": "negation", "en": "Your phone? *I didn't take it*.", "el": "Το κινητό σου; Δεν το πήρα.", "answer": "δεν το πήρα"},
{"rule": "negation", "en": "The children? *I don't hear them*.", "el": "Τα παιδιά; Δεν τα ακούω.", "answer": "δεν τα ακούω"},
{"rule": "negation", "en": "My aunt? *I didn't phone her*.", "el": "Τη θεία μου; Δεν της τηλεφώνησα.", "answer": "δεν της τηλεφώνησα"},
{"rule": "negation", "en": "The soup? *I don't like it*.", "el": "Η σούπα; Δεν μου αρέσει.", "answer": "δεν μου αρέσει", "note": "\"I like\" is μου αρέσει: the thing is the subject, and you're in the genitive."},
{"rule": "negation", "en": "The shoes? *I didn't wear them*.", "el": "Τα παπούτσια; Δεν τα φόρεσα.", "answer": "δεν τα φόρεσα"},
{"rule": "particle", "en": "The book? *I'll read it* tomorrow.", "el": "Το βιβλίο; Θα το διαβάσω αύριο.", "answer": "θα το διαβάσω"},
{"rule": "particle", "en": "*I'll tell you* later.", "el": "Θα σου πω αργότερα.", "answer": "θα σου πω"},
{"rule": "particle", "en": "The door? *I'll close it*.", "el": "Την πόρτα; Θα την κλείσω.", "answer": "θα την κλείσω"},
{"rule": "particle", "en": "Nikos? *I'll phone him* tonight.", "el": "Τον Νίκο; Θα του τηλεφωνήσω απόψε.", "answer": "θα του τηλεφωνήσω"},
{"rule": "particle", "en": "I want *to see you*.", "el": "Θέλω να σε δω.", "answer": "να σε δω"},
{"rule": "particle", "en": "The dishes? *I'll wash them*.", "el": "Τα πιάτα; Θα τα πλύνω εγώ.", "answer": "θα τα πλύνω"},
{"rule": "particle", "en": "Can you *help me*?", "el": "Μπορείς να με βοηθήσεις;", "answer": "να με βοηθήσεις"},
{"rule": "particle", "en": "The book? *I'll give it to you* tomorrow.", "el": "Το βιβλίο; Θα σου το δώσω αύριο.", "answer": "θα σου το δώσω"},
{"rule": "particle", "en": "The letters? I want *to send them to her*.", "el": "Τα γράμματα; Θέλω να της τα στείλω.", "answer": "να της τα στείλω"},
{"rule": "particle", "en": "The soup? *I'll serve it*.", "el": "Τη σούπα; Θα τη σερβίρω.", "answer": "θα τη σερβίρω"},
{"rule": "particle", "en": "The windows? I have *to clean them*.", "el": "Τα παράθυρα; Πρέπει να τα καθαρίσω.", "answer": "να τα καθαρίσω"},
{"rule": "particle", "en": "Your mother? *I'll ask her*.", "el": "Τη μητέρα σου; Θα τη ρωτήσω.", "answer": "θα τη ρωτήσω"},
{"rule": "particle", "en": "*We'll wait for you*.", "el": "Θα σε περιμένουμε.", "answer": "θα σε περιμένουμε"},
{"rule": "particle", "en": "The money? *I'll bring it to you* tomorrow.", "el": "Τα λεφτά; Θα σου τα φέρω αύριο.", "answer": "θα σου τα φέρω"},
{"rule": "particle", "en": "The coffee? I want *to drink it* hot.", "el": "Τον καφέ; Θέλω να τον πιω ζεστό.", "answer": "να τον πιω"},
{"rule": "particle", "en": "The shirt? I don't want *to wear it*.", "el": "Το πουκάμισο; Δεν θέλω να το φορέσω.", "answer": "να το φορέσω"},
{"rule": "particle", "en": "The children? *I'll take them* to school.", "el": "Τα παιδιά; Θα τα πάω στο σχολείο.", "answer": "θα τα πάω"},
{"rule": "particle", "en": "I don't want *to lose you*.", "el": "Δεν θέλω να σε χάσω.", "answer": "να σε χάσω"},
{"rule": "imperative", "en": "The book? *Read it*!", "el": "Το βιβλίο; Διάβασέ το!", "answer": "διάβασέ το", "note": "διάβασε is stressed on its third-last syllable, so before το it takes a second accent: διάβασέ το."},
{"rule": "imperative", "en": "The key? *Give it to me*.", "el": "Το κλειδί; Δώσ' μου το.", "answer": "δώσ' μου το", "also": ["δώσε μου το", "δώσ' το μου", "δώσε το μου"], "note": "After an imperative, δώσ' μου το and δώσ' το μου are both common."},
{"rule": "imperative", "en": "*Tell me*!", "el": "Πες μου!", "answer": "πες μου"},
{"rule": "imperative", "en": "The door? *Close it*, please.", "el": "Την πόρτα; Κλείσ' την, σε παρακαλώ.", "answer": "κλείσ' την", "also": ["κλείσε την"]},
{"rule": "imperative", "en": "*Help me*!", "el": "Βοήθησέ με!", "answer": "βοήθησέ με", "note": "βοήθησε is stressed on its third-last syllable, so it takes a second accent before με."},
{"rule": "imperative", "en": "The milk? *Put it* in the fridge.", "el": "Το γάλα; Βάλ' το στο ψυγείο.", "answer": "βάλ' το", "also": ["βάλε το"]},
{"rule": "imperative", "en": "*Phone me* tomorrow.", "el": "Τηλεφώνησέ μου αύριο.", "answer": "τηλεφώνησέ μου"},
{"rule": "imperative", "en": "The windows? *Open them*.", "el": "Τα παράθυρα; Άνοιξέ τα.", "answer": "άνοιξέ τα"},
{"rule": "imperative", "en": "*Wait for me*!", "el": "Περίμενέ με!", "answer": "περίμενέ με"},
{"rule": "imperative", "en": "Your sister? *Ask her*.", "el": "Την αδελφή σου; Ρώτησέ την.", "answer": "ρώτησέ την", "also": ["ρώτα την"]},
{"rule": "imperative", "en": "The letter? *Send it to him*.", "el": "Το γράμμα; Στείλ' του το.", "answer": "στείλ' του το", "also": ["στείλε του το", "στείλ' το του", "στείλε το του"]},
{"rule": "imperative", "en": "The money? *Take it*.", "el": "Τα λεφτά; Πάρ' τα.", "answer": "πάρ' τα", "also": ["πάρε τα"]},
{"rule": "imperative", "en": "*Look at me*.", "el": "Κοίτα με.", "answer": "κοίτα με", "also": ["κοίταξέ με"]},
{"rule": "imperative", "en": "The keys? *Bring them to me*.", "el": "Τα κλειδιά; Φέρ' τα μου.", "answer": "φέρ' τα μου", "also": ["φέρε τα μου", "φέρε μου τα", "φέρ' μου τα"]},
{"rule": "imperative", "en": "The cake? *Try it*!", "el": "Την τούρτα; Δοκίμασέ την!", "answer": "δοκίμασέ την"},
{"rule": "dont", "en": "The bread? *Don't eat it*!", "el": "Το ψωμί; Μην το φας!", "answer": "μην το φας", "note": "After μην the pronoun goes before the verb again, as with δεν."},
{"rule": "dont", "en": "*Don't tell him* anything!", "el": "Μην του πεις τίποτα!", "answer": "μην του πεις"},
{"rule": "dont", "en": "The window? *Don't open it*.", "el": "Το παράθυρο; Μην το ανοίξεις.", "answer": "μην το ανοίξεις"},
{"rule": "dont", "en": "*Don't wait for me*.", "el": "Μη με περιμένεις.", "answer": "μη με περιμένεις"},
{"rule": "dont", "en": "The money? *Don't lose it*.", "el": "Τα λεφτά; Μην τα χάσεις.", "answer": "μην τα χάσεις"},
{"rule": "dont", "en": "The book? *Don't give it to him*.", "el": "Το βιβλίο; Μην του το δώσεις.", "answer": "μην του το δώσεις"},
{"rule": "dont", "en": "*Don't forget me*!", "el": "Μη με ξεχάσεις!", "answer": "μη με ξεχάσεις"},
{"rule": "dont", "en": "The dog? *Don't touch it*.", "el": "Τον σκύλο; Μην τον αγγίξεις.", "answer": "μην τον αγγίξεις", "note": "ο σκύλος is masculine, so \"it\" is τον."},
{"rule": "dont", "en": "The shoes? *Don't wear them* today.", "el": "Τα παπούτσια; Μην τα φορέσεις σήμερα.", "answer": "μην τα φορέσεις"}
]
